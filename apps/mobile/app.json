{
  "expo": {
    "name": "Keeplas",
    "slug": "keeplas",
    "owner": "keeplas",
    "scheme": "keeplas",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.keeplas.app",
      "associatedDomains": [
        "webcredentials:keeplas.com",
        "webcredentials:app.keeplas.com",
        "applinks:app.keeplas.com"
      ]
    },
    "android": {
      "package": "com.keeplas.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.keeplas.com",
              "pathPrefix": "/link"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/with-ios-scene",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Keeplas uses Face ID to unlock your vault on this device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Keeplas uses the camera to scan documents and the QR code that links a computer to your account.",
          "microphonePermission": "Keeplas uses the microphone to record the sound of videos you add to your vault.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Keeplas lets you add photos and videos from your library to your vault. They are encrypted on this phone first.",
          "cameraPermission": "Keeplas uses the camera to take photos and videos for your vault.",
          "microphonePermission": "Keeplas uses the microphone to record the sound of videos you add to your vault."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Keeplas uses the microphone to record voice notes. They are encrypted on this phone first."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E2340"
        }
      ],
      "expo-sharing",
      "expo-localization",
      "react-native-quick-crypto"
    ],
    "extra": {
      "eas": {
        "projectId": "84efc0af-1893-48d5-963d-b9c6fb73283a"
      }
    }
  }
}
