{
  "expo": {
    "name": "Keeplas",
    "slug": "keeplas",
    "owner": "keeplas",
    "scheme": "keeplas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.keeplas.app",
      "appleTeamId": "67T9Q44562",
      "associatedDomains": [
        "webcredentials:app.keeplas.com",
        "applinks:app.keeplas.com"
      ],
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "BGTaskSchedulerPermittedIdentifiers": ["com.keeplas.app.export.*"]
      }
    },
    "android": {
      "package": "com.keeplas.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.DETECT_SCREEN_CAPTURE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.keeplas.com",
              "pathPrefix": "/link"
            },
            {
              "scheme": "https",
              "host": "app.keeplas.com",
              "pathPrefix": "/capture"
            },
            {
              "scheme": "https",
              "host": "app.keeplas.com",
              "pathPrefix": "/invite/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json"
    },
    "plugins": [
      "expo-router",
      "react-native-compressor",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0E2340",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Italic.ttf",
            "./assets/fonts/Inter-SemiBoldItalic.ttf",
            "./assets/fonts/SourceSerif4-SemiBold.ttf"
          ]
        }
      ],
      "./plugins/with-ios-scene",
      "./plugins/with-android-restricted-resizability",
      "./plugins/with-android-device-reach",
      "expo-secure-store",
      ["expo-camera", { "recordAudioAndroid": true }],
      "expo-image-picker",
      ["expo-audio", { "enableBackgroundPlayback": false }],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E2340"
        }
      ],
      "expo-contacts",
      "expo-sharing",
      ["expo-localization", { "supportedLocales": { "ios": ["en", "fr"] } }],
      "react-native-quick-crypto"
    ],
    "extra": {
      "eas": {
        "projectId": "84efc0af-1893-48d5-963d-b9c6fb73283a"
      }
    }
  }
}
