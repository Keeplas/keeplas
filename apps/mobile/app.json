{
  "expo": {
    "name": "Keeplas",
    "slug": "keeplas",
    "owner": "keeplas",
    "scheme": "keeplas",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.keeplas.app",
      "appleTeamId": "67T9Q44562",
      "associatedDomains": [
        "webcredentials:app.keeplas.com",
        "applinks:app.keeplas.com"
      ],
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": true,
        "BGTaskSchedulerPermittedIdentifiers": ["com.keeplas.app.export.*"],
        "NSPhotoLibraryAddUsageDescription": "Keeplas saves the photos and videos you export from your vault to your library."
      }
    },
    "android": {
      "package": "com.keeplas.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.keeplas.com",
              "pathPrefix": "/link"
            },
            {
              "scheme": "https",
              "host": "app.keeplas.com",
              "pathPrefix": "/capture"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "react-native-compressor",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0E2340",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Italic.ttf",
            "./assets/fonts/Inter-SemiBoldItalic.ttf",
            "./assets/fonts/SourceSerif4-SemiBold.ttf"
          ]
        }
      ],
      "./plugins/with-ios-scene",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Keeplas uses Face ID to unlock your vault on this device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Keeplas uses the camera to scan documents, take photos and videos for your vault, and scan the QR code that links a computer to your account.",
          "microphonePermission": "Keeplas uses the microphone to record voice notes and the sound of videos you add to your vault. They are encrypted on this phone first.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Keeplas lets you add photos and videos from your library to your vault. They are encrypted on this phone first.",
          "cameraPermission": "Keeplas uses the camera to scan documents, take photos and videos for your vault, and scan the QR code that links a computer to your account.",
          "microphonePermission": "Keeplas uses the microphone to record voice notes and the sound of videos you add to your vault. They are encrypted on this phone first."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Keeplas uses the microphone to record voice notes and the sound of videos you add to your vault. They are encrypted on this phone first."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E2340"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Keeplas reads the contact you pick to fill in a trusted person's name, email and phone number. Your address book is not sent anywhere."
        }
      ],
      "expo-sharing",
      "expo-localization",
      "react-native-quick-crypto"
    ],
    "extra": {
      "eas": {
        "projectId": "84efc0af-1893-48d5-963d-b9c6fb73283a"
      }
    }
  }
}
