{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "APP_URL",
        "CONVEX_DEPLOYMENT",
        "CONVEX_MODE",
        "CONVEX_SITE_URL",
        "KEEPLAS_CTX_SECRET",
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
