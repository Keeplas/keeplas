# ═══════════════════════════════════════════════
# Keeplas — Local Development Defaults
# Copy to .env.local (or run `pnpm setup`) and fill the placeholders.
# For the full spec of every key, see .env.example.
# ═══════════════════════════════════════════════

# ─── Application ────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NODE_ENV=development

# ─── WebAuthn (RP_ID = registrable domain, ORIGIN = exact page origin) ─────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Keeplas (Dev)
WEBAUTHN_ORIGIN=http://localhost:3000

# ─── Convex ─────────────────────────────────────
# CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL are written automatically by
# `npx convex dev --once --configure=new` — don't fill them by hand.
CONVEX_MODE=cloud
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ─── Audit HMAC secret (REQUIRED) ───────────────
# Generate once with: openssl rand -base64 32
# Must match the value on your Convex deployment (push via `pnpm sync:convex-env`).
KEEPLAS_CTX_SECRET=

# ─── Email — Resend (optional) ──────────────────
# Without these, OTP-email, Life Check email channel, and the contact form
# no-op gracefully. Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_INBOX_EMAIL=

# ─── Web Push — VAPID (optional) ────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── WhatsApp Cloud API (optional) ──────────────
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=
