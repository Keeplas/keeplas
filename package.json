{
  "name": "keeplas",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source Life Continuity Platform — securely store, organize, and transmit vital information to trusted contacts.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "predev": "pnpm check:env && pnpm check:convex-env",
    "dev": "turbo run dev",
    "prebuild": "pnpm check:env && pnpm check:convex-env",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "check:env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-env.mjs",
    "check:convex-env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.convex.local scripts/check-convex-env.mjs",
    "check:zk": "node scripts/check-zk.mjs",
    "sync:convex-env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.convex.local scripts/sync-convex-env.mjs",
    "link:env": "node scripts/link-env.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "prettier": "^3.5.3",
    "turbo": "^2.9.6",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "convex": "^1.35.1"
  }
}
