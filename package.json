{
  "name": "keeplas",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source Life Continuity Platform — securely store, organize, and transmit vital information to trusted contacts.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "bootstrap": "node scripts/setup.mjs",
    "with-env": "infisical run --domain=https://app.infisical.com --path=/keeplas_app --silent",
    "reset": "node scripts/reset.mjs",
    "predev": "pnpm check:env",
    "dev": "node scripts/dev-with-convex-check.mjs",
    "prebuild": "pnpm check:env",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "check:env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-env.mjs",
    "check:convex-env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.convex.local scripts/check-convex-env.mjs",
    "check:convex": "pnpm check:convex-env",
    "check:zk": "node scripts/check-zk.mjs",
    "debug:whatsapp": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.convex.local scripts/infobip-report.mjs",
    "life-check:force": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/life-check-force.mjs",
    "life-check:escalate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/escalation-trigger.mjs",
    "review:status": "pnpm with-env --env=prod -- node scripts/review-accounts.mjs status",
    "review:reset": "pnpm with-env --env=prod -- node scripts/review-accounts.mjs reset",
    "review:seed": "pnpm with-env --env=prod -- tsx --tsconfig apps/mobile/tsconfig.json apps/mobile/scripts/review-seed.ts",
    "sync:convex-env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=.env.convex.local scripts/sync-convex-env.mjs",
    "link:env": "node scripts/link-env.mjs",
    "predeploy:convex": "pnpm with-env --env=prod -- node scripts/check-convex-deploy.mjs",
    "deploy:convex": "pnpm with-env --env=prod -- npx --no-install convex deploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tsx": "^4.23.15",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "convex": "^1.48.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "hono@<4.12.25": ">=4.12.25",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "ip-address@<=10.1.0": ">=10.1.1",
      "undici@>=7.0.0 <7.30.1": ">=7.30.1 <8",
      "dompurify@<3.4.7": ">=3.4.7",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "@babel/core@<=7.29.0": ">=7.29.6 <8",
      "seroval@>=1.5.5 <1.6.11": ">=1.6.11 <1.7",
      "zod@>=4.0.0 <4.6.6": ">=4.6.6 <5",
      "vitest@>=4.0.0 <4.1.12": ">=4.1.12 <5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-qr28-fpjm-wq7f"
      ]
    }
  },
  "op-sqlite": {
    "sqlcipher": true
  }
}
