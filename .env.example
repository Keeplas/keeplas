# ═══════════════════════════════════════════════
# Keeplas Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Convex
CONVEX_MODE=cloud                          # cloud | selfhosted
CONVEX_DEPLOYMENT=                         # From Convex dashboard
NEXT_PUBLIC_CONVEX_URL=                    # Your Convex deployment URL

# Authentication
# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (https://developer.apple.com)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Passkey / WebAuthn (set on the Convex deployment via `npx convex env set`)
# RP_ID is the registrable domain — "keeplas.com" in prod, "localhost" locally
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Keeplas
# Comma-separated list of allowed origins (must exactly match the page origin)
WEBAUTHN_ORIGIN=http://localhost:3000

# Email (transactional emails for Life Check, invitations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@keeplas.com

# Life Check — Resend (Email channel driver)
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Keeplas <noreply@keeplas.com>

# Life Check — Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@keeplas.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Life Check — WhatsApp Cloud API (Meta Business)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAME=keeplas_life_check
WHATSAPP_TEMPLATE_LANG=en

# Life Check — backend can build absolute URLs in emails/push payloads
APP_URL=http://localhost:3000

# Life Check Channels (post-MVP)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_PHONE=

# Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Backup (optional)
# BACKUP_ENABLED=false
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
