# ═══════════════════════════════════════════════
# Keeplas Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Convex
CONVEX_MODE=cloud                          # cloud | selfhosted
CONVEX_DEPLOYMENT=                         # From Convex dashboard
NEXT_PUBLIC_CONVEX_URL=                    # Your Convex deployment URL

# Authentication
# Passkey / WebAuthn (set on the Convex deployment via `npx convex env set`)
# RP_ID is the registrable domain — "keeplas.com" in prod, "localhost" locally
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Keeplas
# Comma-separated list of allowed origins (must exactly match the page origin)
WEBAUTHN_ORIGIN=http://localhost:3000

# Audit context — HMAC secret used by the Next.js middleware to sign the
# server-attested IP + country payload that every audited mutation carries.
# Convex re-verifies the signature before persisting to the audit log, so the
# secret must be configured BOTH in the web app env (for the middleware) AND
# on the Convex deployment (`npx convex env set KEEPLAS_CTX_SECRET ...`).
# Generate with: openssl rand -base64 32
# Placeholder format below — REPLACE with your own secret in .env.local
KEEPLAS_CTX_SECRET=replace-me-with-openssl-rand-base64-32-output

# Email (transactional emails for Life Check, invitations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@keeplas.com

# Life Check — Resend (Email channel driver)
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Keeplas <noreply@keeplas.com>

# Support — Inbox that receives contact-form submissions (Resend)
SUPPORT_INBOX_EMAIL=prince@prince-code.com

# Life Check — Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@keeplas.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Life Check — WhatsApp Cloud API (Meta Business)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAME=keeplas_life_check
WHATSAPP_TEMPLATE_LANG=en

# Life Check — backend can build absolute URLs in emails/push payloads
APP_URL=http://localhost:3000

# Life Check Channels (post-MVP)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_PHONE=

# Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Backup (optional)
# BACKUP_ENABLED=false
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
