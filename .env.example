# ═══════════════════════════════════════════════
# Keeplas Environment Configuration
# Copy this file to .env and fill in your values.
# Run `pnpm check:env` to validate before `pnpm dev`.
# ═══════════════════════════════════════════════

# ─── Application ────────────────────────────────
# Local dev typically: http://localhost:3000
NEXT_PUBLIC_APP_URL=
APP_URL=
# development | production | test
NODE_ENV=

# ─── Convex ─────────────────────────────────────
# CONVEX_MODE: cloud | selfhosted
# CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL are filled automatically
# the first time you run `npx convex dev --once --configure=new`.
CONVEX_MODE=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Public origin used by Better Auth on the Convex side (Convex auth callbacks
# and email links resolve against this). Typically the same as APP_URL above.
# Pushed to Convex via `pnpm sync:convex-env`.
SITE_URL=

# ─── Authentication / WebAuthn ──────────────────
# RP_ID is the registrable domain — "keeplas.com" in prod, "localhost" locally.
# WEBAUTHN_ORIGIN must match the page origin exactly.
# Set on the Convex deployment too via `pnpm sync:convex-env`.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGIN=

# ─── Audit context (REQUIRED) ───────────────────
# HMAC secret used by the Next.js middleware to sign the server-attested IP +
# country payload that every audited mutation carries. Convex re-verifies the
# signature before persisting to the audit log, so the secret MUST be configured
# both in the web app env (this file) AND on the Convex deployment.
# Generate with: openssl rand -base64 32
# Then push to Convex with: pnpm sync:convex-env
KEEPLAS_CTX_SECRET=

# ─── Email — Resend (optional) ──────────────────
# Required for: Life Check email channel, OTP email auth, contact form.
# Without it, those features no-op gracefully (logged as `*_not_configured`).
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_INBOX_EMAIL=

# ─── Web Push — VAPID (optional) ────────────────
# Required for: Life Check push channel.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── WhatsApp Cloud API (optional) ──────────────
# Required for: Life Check WhatsApp channel, WhatsApp OTP verification.
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=
