# ═══════════════════════════════════════════════
# Keeplas Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Convex
CONVEX_MODE=cloud                          # cloud | selfhosted
CONVEX_DEPLOYMENT=                         # From Convex dashboard
NEXT_PUBLIC_CONVEX_URL=                    # Your Convex deployment URL

# Authentication
# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (https://developer.apple.com)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email (transactional emails for Life Check, invitations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@keeplas.com

# Life Check Channels (post-MVP)
# WHATSAPP_API_KEY=
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_PHONE=

# Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Backup (optional)
# BACKUP_ENABLED=false
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
