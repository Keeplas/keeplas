# ═══════════════════════════════════════════════
# Keeplas Environment Configuration
# Copy this file to .env.local and fill in your values (or run `pnpm bootstrap`).
# This is the single source of truth for every env key — local dev defaults are
# pre-filled (localhost); secrets are left blank for you to provide.
# Run `pnpm check:env` to validate before `pnpm dev`.
# ═══════════════════════════════════════════════

# ─── Application ────────────────────────────────
# Local dev defaults below; override per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# development | production | test
NODE_ENV=development

# ─── Mobile app stores (optional) ───────────────
# Store listings of the Keeplas app. Sign-up is mobile-only: the web "Get the
# app" page (D-01), invitation and /link pages show these badges, and
# /download redirects phones to their store. Unset → badges and /download
# fall back to the "Get the app" page.
NEXT_PUBLIC_APP_STORE_URL= # e.g. https://apps.apple.com/app/keeplas/id0000000000
NEXT_PUBLIC_PLAY_STORE_URL= # e.g. https://play.google.com/store/apps/details?id=com.keeplas.app

# ─── Convex ─────────────────────────────────────
# CONVEX_MODE: cloud | selfhosted
# CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL are filled automatically
# the first time you run `npx convex dev --once --configure=new`.
CONVEX_MODE=cloud
CONVEX_DEPLOYMENT= # Convex deployment
NEXT_PUBLIC_CONVEX_URL= # Cloud URL

# Public origin used by Better Auth on the Convex side (Convex auth callbacks
# and email links resolve against this). Typically the same as APP_URL above.
# Pushed to Convex via `pnpm sync:convex-env`.
SITE_URL=http://localhost:3000

# ─── Authentication / WebAuthn ──────────────────
# RP_ID is the web host serving /.well-known/assetlinks.json and
# apple-app-site-association — "app.keeplas.com" in prod, "localhost" locally.
# WEBAUTHN_ORIGIN must match the page origin exactly. Comma-separate extra
# origins: the mobile app's native passkeys on Android present
# "android:apk-key-hash:<base64url SHA-256 of the signing cert>" (iOS uses the
# web origin through Associated Domains).
# Set on the Convex deployment too via `pnpm sync:convex-env`.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Keeplas (Dev)
WEBAUTHN_ORIGIN=http://localhost:3000

# ─── Audit context (REQUIRED) ───────────────────
# HMAC secret used by the web request middleware (apps/web/src/start.ts) to sign the server-attested IP +
# country payload that every audited mutation carries. Convex re-verifies the
# signature before persisting to the audit log, so the secret MUST be configured
# both in the web app env (this file) AND on the Convex deployment.
# Generate with: openssl rand -base64 32
# Then push to Convex with: pnpm sync:convex-env
KEEPLAS_CTX_SECRET=

# ─── Kill switches (optional) ───────────────────
# Operational pauses read on the Convex deployment (push with `pnpm sync:convex-env`
# or `npx convex env set <KEY> true`). Unset / anything other than "true" or "1" = off.
# NOTIFICATIONS_PAUSED: skip every outbound user-facing notification (Life Check
# check-ins + reminders, trusted-contact notices, invitations, welcome / setup
# reminders). Auth OTPs and the support contact form keep working.
# LIFE_CHECK_PAUSED: freeze the inactivity counting — no new Life Check cycle
# starts and in-flight cycles stop progressing until the flag is cleared.
NOTIFICATIONS_PAUSED=
LIFE_CHECK_PAUSED=

# ─── Email — Resend (optional) ──────────────────
# Required for: Life Check email channel, OTP email auth, contact form.
# Without it, those features no-op gracefully (logged as `*_not_configured`).
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Inbox that receives contact-form submissions (e.g. prince@xxx.com).
SUPPORT_INBOX_EMAIL=
# Optional dedicated sender for contact-form emails (e.g. form@keeplas.com).
# Falls back to RESEND_FROM_EMAIL when unset.
SUPPORT_FROM_EMAIL=
# Reviewer notified of lost-number recovery requests to validate in the admin
# console (kept apart from the general support inbox).
SUPPORT_RECOVERY_EMAIL=
# Admin console (keeplas-website/apps/admin) base URL, linked from the
# reviewer email, e.g. https://keeplas-admin.vercel.app
ADMIN_APP_URL=

# ─── Native push — Expo (optional) ──────────────
# Phone push (security alerts + Life Check) goes through the Expo push
# service. Sends work without it; once "Enhanced Push Security" is enabled in
# the Expo project, Expo rejects any send that lacks this access token.
# https://expo.dev/accounts/[account]/settings/access-tokens
EXPO_ACCESS_TOKEN=

# ─── WhatsApp via Infobip ──────────────
# LOGIN-CRITICAL: phone accounts receive their always-on login OTP over
# WhatsApp — an Infobip outage locks those users out (recovery phrase is the
# only escape hatch). Also required for: Life Check WhatsApp channel, signup
# phone verification, trusted-contact WhatsApp notifications, inbound webhook.
# Likewise Resend (RESEND_API_KEY / RESEND_FROM_EMAIL above) is login-critical
# for email accounts. https://www.infobip.com/docs/api/channels/whatsapp
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_WHATSAPP_SENDER=
# Shared secret verified on the Infobip inbound webhook (a WhatsApp reply =
# Life Check liveness). Sent by Infobip in the x-keeplas-webhook-secret header.
INFOBIP_INBOUND_SECRET=
# Approved template names — must match the Infobip console exactly. Set the
# ENGLISH (`_en`) name here; the French (`_fr`) variant is auto-selected at send
# time from the recipient's language (see `localizedTemplateName` in
# dispatch.ts), so the matching `_fr` template MUST also exist in Infobip
# (keeplas_life_check_fr, keeplas_otp_fr, keeplas_invite_tc_fr,
# keeplas_tc_reconfirm_fr).
WHATSAPP_LIFE_CHECK_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TC_INVITE_TEMPLATE_NAME=
WHATSAPP_TC_RECONFIRM_TEMPLATE_NAME=
# Escalation / grace-window templates. Provision + approve each as an _en/_fr
# pair in the Infobip console (utility category, one placeholder = owner name,
# static "Open Keeplas" URL button). Leave blank to fall back to
# <base>_<locale>; when Infobip creds are absent the send no-ops and email
# still goes out.
WHATSAPP_TC_UNREACHABLE_TEMPLATE_NAME=
WHATSAPP_LC_GRACE_TEMPLATE_NAME=
WHATSAPP_TC_RELEASE_TEMPLATE_NAME=
# New-device alert (M08-4): one placeholder = device label ("Chrome on
# macOS"), static "Open Keeplas" URL button. _en/_fr pair, falls back to
# keeplas_new_device_<locale>.
WHATSAPP_NEW_DEVICE_TEMPLATE_NAME=
# Owner recovery (phase 5): "recovery started" to the owner (no placeholder)
# and "needs your help" to each trust contact (placeholder = owner name). _en/_fr pairs; fall back to keeplas_recovery_started_<locale>
# and keeplas_recovery_contact_<locale>.
WHATSAPP_RECOVERY_STARTED_TEMPLATE_NAME=
WHATSAPP_RECOVERY_CONTACT_TEMPLATE_NAME=
# Account deletion scheduled: one placeholder = deletion date (YYYY-MM-DD),
# static "Open Keeplas" URL button. _en/_fr pair, falls back to
# keeplas_account_deletion_<locale>.
WHATSAPP_ACCOUNT_DELETION_TEMPLATE_NAME=
# Post-onboarding welcome message. Provision + approve as an _en/_fr pair
# (utility category, one placeholder = first name, static "Open Keeplas" URL
# button → https://app.keeplas.com/hub). Leave blank to fall back to
# keeplas_welcome_<locale>; no-ops (email still goes out) until the template is
# approved.
WHATSAPP_WELCOME_TEMPLATE_NAME=
# Day-3 / day-10 setup-completion reminder (one generic template covers both
# stages). Provision + approve as an _en/_fr pair (utility category, one
# placeholder = first name, static "Open Keeplas" URL button →
# https://app.keeplas.com/hub). Leave blank to fall back to
# keeplas_setup_reminder_<locale>; no-ops (email still goes out) until approved.
WHATSAPP_SETUP_REMINDER_TEMPLATE_NAME=
# Base/default template language. The per-message `language` sent to Infobip is
# now derived from the recipient's locale (en/fr), so this is only a fallback
# default; it is not what picks the _fr template (the name suffix does).
WHATSAPP_TEMPLATE_LANG=en

# ─── Payments — Stripe (optional) ───────────────
# Powers the one-time Lifetime checkout. Without these the Subscription page
# upgrade button no-ops. Read only on the Convex deployment (checkout action +
# webhook) — push with `pnpm sync:convex-env`. No NEXT_PUBLIC_* key: checkout is
# Stripe-hosted (redirect), so the browser never loads Stripe.js.
# Secret API key (test: sk_test_…). https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret for the /webhooks/stripe endpoint (whsec_…). From the Stripe
# CLI (`stripe listen`) locally, or the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=
# Price id of the one-time Lifetime product ($199). Create a Product with a
# one-time price in Stripe and paste its `price_…` id here.
STRIPE_PRICE_LIFETIME=

# ─── Mobile sign-up attestation (App Attest / Play Integrity) ───
# Sign-up is mobile-only (F8): a phone sign-up code is only issued once the
# genuine Keeplas app proved itself (packages/convex/attestation_node.ts).
# Read only on the Convex deployment — push with `pnpm sync:convex-env`.
# iOS App Attest: app id = APPLE_TEAM_ID.IOS_BUNDLE_ID.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.keeplas.app
# DEV ONLY, never synced: "true" also accepts development-signed builds
# (aaguid appattestdevelop). Set by hand on a dev deployment:
#   npx convex env set APP_ATTEST_ALLOW_DEVELOPMENT true
APP_ATTEST_ALLOW_DEVELOPMENT=
# Android Play Integrity (standard requests). The service account needs the
# Play Integrity API enabled on the linked Google Cloud project. Paste the
# whole JSON key on one line.
ANDROID_PACKAGE_NAME=com.keeplas.app
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT=
# DEV ONLY, never synced: "true" lets simulators / emulators sign up without
# attestation. NEVER set it on production. Set by hand on a dev deployment:
#   npx convex env set ATTESTATION_SIMULATOR_BYPASS true
ATTESTATION_SIMULATOR_BYPASS=
# DEV ONLY, never synced: comma-separated E.164 numbers that always accept the
# code 000000 and get no WhatsApp message (simulator testing). NEVER set it on
# production. Set by hand on a dev deployment:
#   npx convex env set DEV_TEST_PHONES "+33600000001,+33600000002"
DEV_TEST_PHONES=
# App Store / Play review demo account, prod-safe: these comma-separated E.164
# numbers sign in (never sign up) with the secret 6-digit REVIEW_CODE instead
# of a WhatsApp code. Put the number, the code and the account's 24 words in
# the store review notes. Leave empty to disable.
REVIEW_PHONES=
REVIEW_CODE=

# ─── Owner recovery gate key (KMS) ──────────────
# The trust-contact recovery gate key G is stored under a KMS and released
# only by packages/convex/recovery_node.ts after 2 approvals + 72 h.
# Read only on the Convex deployment — push with `pnpm sync:convex-env`.
# GATE_KEY_KMS: infisical (production) | local (dev / self-hosting tests).
GATE_KEY_KMS=local
# local: 32 random bytes, base64. Generate with: openssl rand -base64 32
GATE_KEY_LOCAL_KEK=
# infisical: an AES-GCM-256 key in an Infisical KMS project, and a machine
# identity (Universal Auth) whose only permission is encrypt/decrypt on it.
# Site URL: https://app.infisical.com, https://eu.infisical.com or self-hosted.
INFISICAL_KMS_SITE_URL=
INFISICAL_KMS_KEY_ID=
INFISICAL_KMS_CLIENT_ID=
INFISICAL_KMS_CLIENT_SECRET=

# ─── App association (web host) ──────────────────
# Served by apps/web at /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json so QR links (/link) and invitations (/invite/*)
# open the mobile app, and its native passkeys share the web relying party.
# APPLE_TEAM_ID / IOS_BUNDLE_ID / ANDROID_PACKAGE_NAME above are reused.
# Comma-separated SHA-256 fingerprints of the Android signing certificates
# (Play App Signing + upload key), e.g. "AB:CD:...".
ANDROID_SHA256_CERT_FINGERPRINTS=

# ─── Mobile app (apps/mobile, Expo) ─────────────
# Expo inlines EXPO_PUBLIC_* into the app bundle at build time (public, never
# secrets). They are read from apps/mobile/.env.local, which `pnpm link:env`
# symlinks to this root .env.local; restart `expo start` after a change.
# Same Convex deployment as NEXT_PUBLIC_CONVEX_URL.
EXPO_PUBLIC_CONVEX_URL=
# Web app origin. Serves GET /api/context (sealed audit context for audited
# mutations) and hosts the pairing universal link /link (QR codes are only
# accepted for this origin). Use a LAN / tunnel URL for a physical device.
EXPO_PUBLIC_APP_URL=http://localhost:3000
# Google Cloud project number linked to the Play Integrity API (Android
# sign-up attestation). Not needed for iOS or simulators.
EXPO_PUBLIC_GCP_PROJECT_NUMBER=
# EAS cloud builds do not read .env.local: set the EXPO_PUBLIC_* values above
# as EAS environment variables (development / preview / production), see
# apps/mobile/README.md.
# Path to the Firebase google-services.json (Android push via FCM). EAS builds
# get it from an EAS "file" variable of this name; locally, drop the file at
# apps/mobile/google-services.json (gitignored) instead.
GOOGLE_SERVICES_JSON=
# Source copy of that google-services.json content, on one line (Infisical
# keeps it). Restore the local file with:
#   pnpm -s with-env -- sh -c 'printf %s "$ANDROID_GOOGLE_SERVICES_JSON"' > apps/mobile/google-services.json
ANDROID_GOOGLE_SERVICES_JSON=
