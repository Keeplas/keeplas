# Vercel attributes deploys to the commit author; a non-team author email
# gets the deployment blocked. Fail fast before any other work.
email="$(git config user.email)"
case "$email" in
  princenocode@gmail.com | mitahighislain@gmail.com) ;;
  *)
    echo "✖ Commit author email '$email' is not a Vercel team address."
    echo "  Use princenocode@gmail.com or mitahighislain@gmail.com in git config user.email."
    exit 1
    ;;
esac

pnpm exec lint-staged
pnpm check:zk
