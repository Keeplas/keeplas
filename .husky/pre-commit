# Team-only (opt-in): Vercel attributes deploys to the commit author and
# blocks deployments from a non-team author email. Founders who deploy via
# Vercel can set KEEPLAS_TEAM=1 to catch a misconfigured user.email early.
# Contributors don't need this — commit with your own email.
if [ "$KEEPLAS_TEAM" = "1" ]; then
  email="$(git config user.email)"
  case "$email" in
    princenocode@gmail.com | mitahighislain@gmail.com) ;;
    *)
      echo "✖ KEEPLAS_TEAM=1 but commit author email '$email' is not a Vercel team address."
      echo "  Set your own team email in git config user.email, or unset KEEPLAS_TEAM."
      exit 1
      ;;
  esac
fi

pnpm exec lint-staged
pnpm check:zk
