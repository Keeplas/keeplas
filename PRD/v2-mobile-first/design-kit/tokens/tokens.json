    "card": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(14,35,64,.05), 0 6px 18px rgba(14,35,64,.06)"
    },
    "raised": {
      "$type": "shadow",
      "$value": "0 2px 6px rgba(14,35,64,.08), 0 14px 32px rgba(14,35,64,.10)"
    },
    "fab": {
      "$type": "shadow",
      "$value": "0 6px 16px rgba(16,40,68,.35)"
    },
    "focus": {
      "$type": "shadow",
      "$value": "0 0 0 3px rgba(35,139,202,.35)"
    }
  },
  "motion": {
    "fast": {
      "$value": "120ms"
    },
    "base": {
      "$value": "200ms"
    },
    "slow": {
      "$value": "320ms"
    },
    "ease": {
      "$value": "cubic-bezier(.2,.7,.2,1)"
    }
  }
