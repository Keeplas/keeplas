  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "'Source Serif 4', 'Source Serif Pro', Georgia, serif"
    },
    "ui": {
      "$type": "fontFamily",
      "$value": "'Inter', -apple-system, 'SF Pro Text', Roboto, 'Segoe UI', sans-serif"
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "36px",
        "lineHeight": "40px",
        "fontWeight": 600,
        "letterSpacing": "-0.5px"
      },
      "$description": "Welcome title (Your life, well kept)"
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "30px",
        "lineHeight": "34px",
        "fontWeight": 600,
        "letterSpacing": "-0.4px"
      },
      "$description": "Screen title"
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "24px",
        "lineHeight": "30px",
        "fontWeight": 600,
        "letterSpacing": "-0.2px"
      },
      "$description": "Section title, modal"
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "19px",
        "lineHeight": "24px",
        "fontWeight": 600,
        "letterSpacing": "0px"
      },
      "$description": "Card title"
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.ui}",
        "fontSize": "17px",
        "lineHeight": "25px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "$description": "Screen subtitle"
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.ui}",
        "fontSize": "15px",
        "lineHeight": "22px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "$description": "Body text, list rows"
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.ui}",
        "fontSize": "15px",
        "lineHeight": "20px",
        "fontWeight": 600,
        "letterSpacing": "0px"
      },
      "$description": "Row label, button"
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.ui}",
        "fontSize": "13px",
        "lineHeight": "18px",
        "fontWeight": 400,
        "letterSpacing": "0px"
      },
      "$description": "Description under a label"
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.ui}",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 500,
        "letterSpacing": "0.1px"
      },
      "$description": "Tab bar, metadata"
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.ui}",
        "fontSize": "34px",
        "lineHeight": "40px",
        "fontWeight": 600,
        "letterSpacing": "4px"
      },
      "$description": "Recovery code (tabular figures)"
    }
